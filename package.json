{
  "name": "solitaire-collection-ru",
  "productName": "Пасьянс — Коллекция",
  "description": "Семь пасьянсов на русском: дуэли, башни, марафон, достижения и мастерство",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Solitaire Collection",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "windows": "npm run build && electron-builder --win zip --x64",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "ru.solitaire.collection",
    "productName": "Solitaire Collection RU",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "artifactName": "Solitaire-Collection-RU-${version}-${arch}.${ext}",
    "extraFiles": [
      {
        "from": "WINDOWS.txt",
        "to": "НАЧАТЬ ЗДЕСЬ.txt"
      }
    ],
    "electronLanguages": [
      "ru",
      "en-US"
    ]
  }
}
